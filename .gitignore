# --- 비밀키 (절대 올리지 말 것) ---
serviceAccountKey.json
*serviceAccount*.json
.env
.env.*
!.env.example

# --- 의존성 / 빌드 산출물 ---
node_modules/
.netlify/
dist/
build/

# --- 로그 / 임시 ---
*.log
npm-debug.log*
.cache/
tmp/

# --- 에디터 / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- 문제 은행 백업 (용량이 커서 제외, 원본은 Firestore에 있음) ---
problems_bank.backup.json
problems_bank.*.json